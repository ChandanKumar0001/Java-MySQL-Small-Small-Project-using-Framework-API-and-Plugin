<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<h1>Update the Car Details</h1>
	<form action="update-car" method="post">
	<!-- method should be post because default value is get in method attribute -->
		<input type="number" value="<%=rs.getInt(1) %>" name="carId" readonly="readonly"><br>
		<input type="text"  name="carModel"><br>
		<input type="text"  name="carBrand"><br>
		<input type="text"  name="carColour"><br>
		<input type="number"  name="carPrice"><br>
		<input type="submit" value="UPDATE">
	</form>
</body>
</html>