<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
	<display-name>Archetype Created Web Application</display-name>

	<!-- SERVLET TAGS -->
	<servlet>
		<servlet-name>ADD</servlet-name>
		<servlet-class>com.jsp.servlet.AddServlet</servlet-class>
	</servlet>
	
	<servlet>
		<servlet-name>SUB</servlet-name>
		<servlet-class>com.jsp.servlet.Subtract</servlet-class>
	</servlet>
	
	<servlet>
		<servlet-name>MUL</servlet-name>
		<servlet-class>com.jsp.servlet.Multiply</servlet-class>
	</servlet>
	
	<servlet>
		<servlet-name>DIV</servlet-name>
		<servlet-class>com.jsp.servlet.Divide</servlet-class>
	</servlet>
	
	<servlet>
		<servlet-name>MOD</servlet-name>
		<servlet-class>com.jsp.servlet.Modelus</servlet-class>
	</servlet>

	<!-- SERVLET-MAPPING TAGS -->
	<servlet-mapping>
		<servlet-name>ADD</servlet-name>
		<url-pattern>/add_numbers</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>SUB</servlet-name>
		<url-pattern>/sub_numbers</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>MUL</servlet-name>
		<url-pattern>/mul_numbers</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>DIV</servlet-name>
		<url-pattern>/div_numbers</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>MOD</servlet-name>
		<url-pattern>/mod_numbers</url-pattern>
	</servlet-mapping>
	
</web-app>
