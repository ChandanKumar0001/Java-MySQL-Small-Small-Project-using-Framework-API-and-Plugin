<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
    
    <!-- Bean Definition -->
    <bean id="car-bean" class="com.jsp.spring.di.Car">  
    
    <!-- For Setter Injection  -->
    <!--  
    <property name = "engine" ref = "engine-bean" ></property> 
    </bean>   
    -->
    
    <!-- For Constructor Injection  -->
    <constructor-arg name = "engine" ref = "engine-bean" ></constructor-arg> 
    </bean> 
    
    <bean id="engine-bean" class="com.jsp.spring.di.Engine"></bean>
</beans>
